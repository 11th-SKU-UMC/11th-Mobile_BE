          "name": "01A 준비 - 회원 A 가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/members",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"a{{runId}}@example.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"a{{runId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now().toString().slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('응답 코드 COMMON201', () => pm.expect(json.code).to.eql('COMMON201'));",
                  "pm.test('공통 응답 형식', () => { pm.expect(json).to.have.all.keys('isSuccess','code','message','result'); pm.expect(json.isSuccess).to.eql(true); });",
                  "pm.collectionVariables.set('memberA', json.result.memberId);"
                ]
              }
            }
          ]
        },
