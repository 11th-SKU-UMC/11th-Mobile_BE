  "item": [
    {
      "name": "01 회원 A 가입",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/members",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a{{runId}}@example.com\",\n  \"password\": \"OnlyTest!123\",\n  \"nickname\": \"a{{runId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", Date.now().toString(36));",
              "pm.collectionVariables.unset(\"tokenA\");",
              "pm.collectionVariables.unset(\"tokenB\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const response = pm.response.json();",
              "pm.test(\"응답 코드 COMMON201\", () => pm.expect(response.code).to.eql(\"COMMON201\"));",
              "pm.test(\"공통 응답\", () => { pm.expect(response).to.have.all.keys(\"isSuccess\", \"code\", \"message\", \"result\"); pm.expect(response.isSuccess).to.eql(true); });"
            ]
          }
        }
      ]
    },
